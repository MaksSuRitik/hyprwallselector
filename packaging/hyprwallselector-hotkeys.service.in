[Unit]
Description=Hyprwallselector shortcut broker
[Service]
Type=dbus
BusName=org.hyprwallselector.Hotkeys
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/hyprwallselector-hotkeys
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=char-input r
UMask=0077
